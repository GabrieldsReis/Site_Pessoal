<html lang="pt-BR">
@model List<EstoqueWeb.Models.Produto>

<body>

    <header class="site">
        <div class="brand">
            <span class="mark">EstoqueWeb</span>
            <span class="sub">v0.1 · protótipo estático</span>
        </div>
        <nav class="site">
            <a href="#" class="active">Estoque</a>
            <a href="#adicionar">Adicionar</a>
            <a href="#">Relatórios</a>
        </nav>
    </header>

    <main>
        <p class="eyebrow">Painel</p>
        <h1 class="page-title">Estoque atual</h1>

        <div class="summary">
            <div class="tag">
                <span class="num">@Model.Count</span>
                <span class="label">Produtos cadastrados</span>
            </div>
            <div class="tag warn">
                R$ @Model.Sum(p => (p.PrecoVenda - p.PrecoCompra) * p.Quantidade).ToString("N2")
                <span class="label" style="color:green">Lucro Potencial</span>
            </div>
            <div class="tag">
                R$ @Model.Sum(p => p.PrecoCompra * p.Quantidade).ToString("N2") <span class="label">Valor total em
                estoque</span>
            </div>
        </div>

        <section class="ledger">
            <div class="ledger-head">
                <h2>Produtos</h2>
                <span class="hint">dados de exemplo — troque pelos produtos reais depois</span>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th style="text-align:right">Qtd.</th>
                        <th style="text-align:right">Preço</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td>@produto.Id</td>
                            <td>@produto.Nome</td>
                            <td>@produto.Categoria</td>
                            <td>@produto.Quantidade</td>
                            <td>R$ @produto.PrecoVenda.ToString("N2")</td>
                            <td>
                                @if (produto.Status == "Em estoque")
                                {
                                    <span class="status ok">@produto.Status</span>
                                }
                                else if (produto.Status == "Baixo")
                                {
                                    <span class="status low">@produto.Status</span>
                                }
                                else
                                {
                                    <span class="status out">@produto.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="add-card" id="adicionar">
            <h2>Adicionar produto</h2>
            <form class="add-form">
                <div class="field">
                    <label for="nome">Nome do produto</label>
                    <input type="text" id="nome" placeholder="Ex: Caneta esferográfica azul">
                </div>
                <div class="field">
                    <label for="categoria">Categoria</label>
                    <select id="categoria">
                        <option>Papelaria</option>
                        <option>Escritório</option>
                        <option>Limpeza</option>
                        <option>Outro</option>
                    </select>
                </div>
                <div class="field">
                    <label for="qtd">Quantidade</label>
                    <input type="number" id="qtd" placeholder="0">
                </div>
                <div class="field">
                    <label for="preco">Preço (R$)</label>
                    <input type="text" id="preco" placeholder="0,00">
                </div>
                <div class="submit-row">
                    <button type="button" class="btn-primary">Cadastrar produto →</button>
                </div>
            </form>
        </section>
    </main>


</body>

</html>
