@model List<EstoqueWeb.Models.Produto>

@{
    decimal lucro = Model.Sum(p => (p.PrecoVenda - p.PrecoCompra) * p.Quantidade);
    decimal valorEstoque = Model.Sum(p => p.PrecoCompra * p.Quantidade);
    int produtosBaixos = Model.Count(p => p.Quantidade <= 10);
}
<!--*vou arrumar isso dps, pra um view */ -->

<html lang="pt-BR">

<body>

    <header class="site">
        <div class="brand">
            <span class="mark">EstoqueWeb</span>
            <span class="sub">v0.1 · protótipo estático</span>
        </div>

        <nav class="site">
            <a href="#" class="active">Estoque</a>
            <a href="#adicionar">Adicionar</a>
            <a href="#">Relatórios</a>
        </nav>
    </header>

    <main>

        <p class="eyebrow">Painel</p>
        <h1 class="page-title">Estoque atual</h1>

        <div class="summary">

            <div class="tag">
                <span class="num">@Model.Count</span>
                <span class="label">Produtos cadastrados</span>
            </div>

            <div class="tag warn">

                <span class="num" style="color:@(lucro >= 0 ? "green" : "red")">

                    R$ @lucro.ToString("N2")

                </span>

                <span class="label">
                    @(lucro >= 0 ? "Lucro Potencial" : "Prejuízo")
                </span>

            </div>

            <div class="tag">
                <span class="num">
                    R$ @valorEstoque.ToString("N2")
                </span>

                <span class="label">
                    Valor total em estoque
                </span>
            </div>

            <div class="tag">
                <span class="num">@produtosBaixos</span>
                <span class="label">Itens com estoque baixo</span>
            </div>

        </div>

        <section class="ledger">

            <div class="ledger-head">
                <h2>Produtos</h2>
                <span class="hint">
                    Produtos cadastrados no banco de dados
                </span>
            </div>

            <table>

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th style="text-align:right">Qtd.</th>
                        <th style="text-align:right">Preço</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var produto in Model)
                    {
                        <tr>

                            <td>@produto.Id</td>

                            <td>@produto.Nome</td>

                            <td>@produto.Categoria</td>

                            <td>@produto.Quantidade</td>

                            <td>
                                R$ @produto.PrecoVenda.ToString("N2")
                            </td>

                            <td>

                                @if (produto.Status == "Em estoque")
                                {
                                    <span class="status ok">
                                        @produto.Status
                                    </span>
                                }
                                else if (produto.Status == "Baixo")
                                {
                                    <span class="status low">
                                        @produto.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="status out">
                                        @produto.Status
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </section>

        <section class="add-card" id="adicionar">

            <h2>Adicionar produto</h2>

            <form asp-action="Create" method="post">

                <input asp-for="NovoProduto.Nome" placeholder="Nome">

                <input asp-for="NovoProduto.Categoria" placeholder="Categoria">

                <input asp-for="NovoProduto.Quantidade" placeholder="Quantidade">

                <input asp-for="NovoProduto.PrecoCompra" placeholder="Preço compra">

                <input asp-for="NovoProduto.PrecoVenda" placeholder="Preço venda">


                <button type="submit">
                    Cadastrar
                </button>

            </form>

        </section>

    </main>

</body>

</html>