<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#fbf5f3" /><meta name="description" content="@(ViewData["Description"] ?? "Conheça os produtos, consulte a disponibilidade e fale diretamente com a loja.")" /><meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" /><meta property="og:title" content="@ViewData["Title"] · @(ViewData["StoreName"] ?? "Minha loja")" /><meta property="og:description" content="@(ViewData["Description"] ?? "Conheça os produtos, consulte a disponibilidade e fale diretamente com a loja.")" /><meta name="twitter:card" content="summary" /><title>@ViewData["Title"] · @(ViewData["StoreName"] ?? "Minha loja")</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index">@(ViewData["StoreName"] ?? "Minha loja")<span>beleza com carinho</span></a><nav><a asp-controller="Home" asp-action="Index">Início</a><a href="/#catalogo">Produtos</a><button id="open-cart" class="cart-trigger" type="button">Sacola <span id="cart-count">0</span></button></nav></header>
<main>@RenderBody()</main><footer class="footer"><span>Atendimento feito diretamente pela loja.</span><a href="/admin/entrar">Acesso da loja</a></footer>
<dialog id="cart-dialog" class="cart-dialog"><div class="cart-head"><div><p class="eyebrow">Sua seleção</p><h2>Minha sacola</h2></div><button id="close-cart" class="icon-button" aria-label="Fechar sacola">×</button></div><p id="cart-empty" class="muted">Sua sacola está vazia. Explore os produtos e toque em + para adicionar.</p><div id="cart-lines"></div><p class="cart-total">Total estimado <strong id="cart-total">R$ 0,00</strong></p><p class="muted">Preço, disponibilidade e entrega serão confirmados pela loja. O pedido só é enviado quando você tocar em enviar no WhatsApp.</p><button id="checkout" class="button button-dark" type="button">Enviar pedido pelo WhatsApp</button><p id="cart-message" class="form-message" role="status"></p></dialog>
@if (string.IsNullOrWhiteSpace(ViewData["WhatsApp"]?.ToString())) { <p class="muted" id="whatsapp-not-configured">O WhatsApp da loja ainda não foi configurado. Avise a administração.</p> }
<form id="cart-token">@Html.AntiForgeryToken()</form><script type="application/json" id="cart-catalog">@Html.Raw(ViewData["CartCatalog"] ?? "[]")</script><script>window.storeSettings = { phone: '@(ViewData["WhatsApp"] ?? "")' };</script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
