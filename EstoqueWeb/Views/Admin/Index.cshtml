@model EstoqueWeb.ViewModels.AdminDashboardViewModel
@{ ViewData["Title"] = "Painel da loja"; }
<section class="admin-shell"><div class="admin-header"><div><p class="eyebrow">Área administrativa</p><h1>Produtos</h1></div><div class="admin-nav"><a asp-action="Novo">+ Novo produto</a><a asp-action="Categorias">Categorias</a><a asp-action="Configuracoes">Configurações</a><form asp-action="Sair" method="post"><button type="submit">Sair</button></form></div></div>
@if (TempData["Mensagem"] is string message) { <p class="success" role="status">@message</p> }<form method="get" class="filters"><label class="search-field"><span class="sr-only">Buscar produto</span><input name="busca" value="@Model.Busca" placeholder="Buscar por nome ou categoria"/></label><button class="filter-submit">Buscar</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Produto</th><th>Categoria</th><th>Preço</th><th>Quantidade</th><th>Visibilidade</th><th>Ações</th></tr></thead><tbody>@foreach(var p in Model.Produtos){<tr><td>@p.Nome @if(p.IsFeatured){<small> · Destaque</small>}</td><td>@p.Categoria</td><td>@p.PrecoVenda.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td><td>@p.Quantidade</td><td>@(p.IsActive ? "Ativo" : "Oculto")</td><td><div class="admin-actions"><a asp-action="Novo" asp-route-id="@p.Id">Editar</a><form class="inline-form" asp-action="Status" asp-route-id="@p.Id" method="post"><button>@(p.IsActive ? "Desativar" : "Ativar")</button></form><form class="inline-form" asp-action="Excluir" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Remover este produto permanentemente?')"><button class="danger">Remover</button></form></div></td></tr>}</tbody></table></div>
</section>
