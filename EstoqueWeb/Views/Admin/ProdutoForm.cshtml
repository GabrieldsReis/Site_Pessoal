@model EstoqueWeb.ViewModels.ProdutoAdminViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Novo produto" : "Editar produto"; }
<section class="admin-panel"><a class="back-link" asp-action="Index">← Voltar aos produtos</a><h1>@ViewData["Title"]</h1><form asp-action="Salvar" method="post" enctype="multipart/form-data" class="admin-form"><input asp-for="Id" type="hidden"/><input asp-for="ImageUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="error"></div>
<label asp-for="Nome">Nome<input asp-for="Nome" maxlength="120"/></label><span asp-validation-for="Nome" class="error"></span><label asp-for="Descricao">Descrição<textarea asp-for="Descricao" rows="4"></textarea></label><label asp-for="Categoria">Categoria<input asp-for="Categoria" list="category-list" placeholder="Ex.: Maquiagem"/><datalist id="category-list"><option value="Maquiagem"/><option value="Cuidados com a pele"/><option value="Cabelos"/><option value="Perfumaria"/></datalist></label><div class="admin-form" style="grid-template-columns:1fr 1fr"><label asp-for="PrecoVenda">Preço de venda (R$)<input asp-for="PrecoVenda" type="number" min="0.01" max="999999.99" step="0.01"/></label><label asp-for="Quantidade">Quantidade em estoque<input asp-for="Quantidade" type="number" min="0" step="1"/></label></div><label asp-for="PrecoCompra">Preço de compra (interno)<input asp-for="PrecoCompra" type="number" min="0" step="0.01"/></label><label asp-for="Imagem">Foto principal (JPEG, PNG ou WebP; até 5 MB)<input asp-for="Imagem" type="file" accept="image/jpeg,image/png,image/webp"/><span asp-validation-for="Imagem" class="error"></span></label>@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img src="@Model.ImageUrl" alt="Foto atual de @Model.Nome" style="max-width:150px"/>}<label class="checkbox-row"><input asp-for="IsActive"/> Produto ativo na loja</label><label class="checkbox-row"><input asp-for="IsFeatured"/> Destacar na vitrine</label><button class="button button-dark">Salvar produto</button></form></section>
