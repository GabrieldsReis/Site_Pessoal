@model EstoqueWeb.ViewModels.ConfiguracaoLojaViewModel
@{ ViewData["Title"] = "Configurações da loja"; }
<section class="admin-panel"><a class="back-link" asp-action="Index">← Painel</a><p class="eyebrow">Informações públicas</p><h1>Configurações</h1>@if(TempData["Mensagem"] is string msg){<p class="success">@msg</p>}<form asp-action="Configuracoes" method="post" class="admin-form"><div asp-validation-summary="ModelOnly" class="error"></div><label asp-for="NomeLoja">Nome da loja<input asp-for="NomeLoja"/></label><label asp-for="TelefoneWhatsApp">WhatsApp em formato internacional<input asp-for="TelefoneWhatsApp" placeholder="+5511999999999"/><small>Use DDI e DDD. Não coloque espaços.</small></label><span asp-validation-for="TelefoneWhatsApp" class="error"></span><label asp-for="InstagramUrl">Instagram (link completo)<input asp-for="InstagramUrl" placeholder="https://instagram.com/..."/></label><label asp-for="TextoApresentacao">Apresentação<textarea asp-for="TextoApresentacao" rows="4"></textarea></label><label asp-for="RegiaoAtendida">Região atendida<input asp-for="RegiaoAtendida"/></label><label asp-for="FormasEntrega">Entrega e retirada<textarea asp-for="FormasEntrega" rows="2"/></label><label asp-for="FormasPagamento">Formas de pagamento<textarea asp-for="FormasPagamento" rows="2"/></label><button class="button button-dark">Salvar configurações</button></form></section>
