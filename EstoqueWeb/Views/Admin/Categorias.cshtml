@model IReadOnlyList<EstoqueWeb.Models.Categoria>
@{ ViewData["Title"] = "Categorias"; }
<section class="admin-panel"><a class="back-link" asp-action="Index">← Painel</a><p class="eyebrow">Organização</p><h1>Categorias</h1>@if(TempData["Erro"] is string erro){<p class="error">@erro</p>}<form asp-action="SalvarCategoria" method="post" class="admin-form"><label for="nome">Adicionar categoria<input id="nome" name="nome" maxlength="80" required/></label><button class="button button-dark">Adicionar</button></form><div style="margin-top:25px">@foreach(var c in Model){<div class="category-row"><span>@c.Nome @(c.IsActive ? "" : "(desativada)")</span><div><form asp-action="SalvarCategoria" method="post" class="inline-form"><input type="hidden" name="id" value="@c.Id"/><label class="sr-only" for="categoria-@c.Id">Nome da categoria @c.Nome</label><input id="categoria-@c.Id" name="nome" value="@c.Nome" maxlength="80" required/><button>Salvar nome</button></form><form asp-action="StatusCategoria" asp-route-id="@c.Id" method="post" class="inline-form"><button>@(c.IsActive ? "Desativar" : "Ativar")</button></form></div></div>}</div><p class="muted">Ao renomear, os produtos vinculados são atualizados junto.</p></section>
