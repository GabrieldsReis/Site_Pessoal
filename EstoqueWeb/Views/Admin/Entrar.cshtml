@model EstoqueWeb.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Acesso da loja"; }
<section class="admin-panel"><p class="eyebrow">Área protegida</p><h1>Entrar no painel</h1><p class="muted">Acesso exclusivo para a pessoa responsável pela loja.</p><form asp-action="Entrar" method="post" class="admin-form"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="error"></div><label asp-for="Email">E-mail<input asp-for="Email" autocomplete="username"/></label><span asp-validation-for="Email" class="error"></span><label asp-for="Password">Senha<input asp-for="Password" autocomplete="current-password"/></label><span asp-validation-for="Password" class="error"></span><button class="button button-dark" type="submit">Entrar</button></form></section>
