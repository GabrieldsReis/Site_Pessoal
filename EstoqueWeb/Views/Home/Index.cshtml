@model EstoqueWeb.ViewModels.LojaPublicaViewModel
@{ ViewData["Title"] = Model.NomeLoja; ViewData["StoreName"] = Model.NomeLoja; ViewData["Description"] = Model.Apresentacao; ViewData["WhatsApp"] = Model.TelefoneWhatsApp; }
<section class="hero"><div class="hero-copy"><p class="eyebrow">Um carinho para você</p><h1>Beleza que combina <em>com você.</em></h1><p>@Model.Apresentacao</p><div class="hero-actions"><a class="button button-dark" href="#catalogo">Explorar produtos</a>@if (!string.IsNullOrWhiteSpace(Model.TelefoneWhatsApp)) { <a class="text-link" target="_blank" rel="noopener" href="https://wa.me/@System.Text.RegularExpressions.Regex.Replace(Model.TelefoneWhatsApp, "[^0-9]", "")">Conversar pelo WhatsApp ↗</a> }</div></div><div class="hero-art" aria-hidden="true"><span class="sun"></span><div class="bottle bottle-one"></div><div class="bottle bottle-two"></div><div class="flower">✳</div><p>seu momento<br />de cuidado</p></div></section>
<section class="catalog-section" id="catalogo"><div class="section-heading"><div><p class="eyebrow">Escolhidos com carinho</p><h2>Encontre seu próximo favorito</h2></div><p>Consulte disponibilidade e detalhes com a loja.</p></div>
<form method="get" class="filters"><label class="search-field"><span class="sr-only">Pesquisar produto</span><input name="busca" value="@ViewData["Busca"]" placeholder="O que você procura?"/><button aria-label="Pesquisar">⌕</button></label><label><span class="sr-only">Filtrar categoria</span><select name="categoria" onchange="this.form.submit()"><option value="">Todas as categorias</option>@foreach(var cat in Model.Categorias) { <option value="@cat" selected="@(ViewData["Categoria"]?.ToString()==cat)">@cat</option> }</select></label><button class="filter-submit" type="submit">Buscar</button></form>
@if (Model.Produtos.Count == 0) { <div class="empty-state"><span>✿</span><h3>Nenhum produto por aqui ainda</h3><p>Volte em breve para conhecer as novidades da loja.</p></div> } else {
<div class="product-grid">@foreach (var p in Model.Produtos) { <article class="product-card" data-product-id="@p.Id" data-product-name="@p.Nome" data-price="@p.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-available="@p.Disponivel.ToString().ToLowerInvariant()"><a class="product-image" asp-action="Produto" asp-route-id="@p.Id" aria-label="Ver @p.Nome">@if (!string.IsNullOrWhiteSpace(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.Nome" loading="lazy" /> } else { <div class="image-placeholder" aria-label="Foto do produto ainda não cadastrada"><span>✿</span><small>foto em breve</small></div> } @if (p.Destaque) { <span class="featured">Destaque</span> }</a><div class="product-info"><p class="product-category">@p.Categoria</p><h3><a asp-action="Produto" asp-route-id="@p.Id">@p.Nome</a></h3><div class="product-bottom"><div><strong>@p.PrecoVenda.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><span class="availability @(p.Disponivel ? "" : "sold-out")">@(p.Disponivel ? "Disponível" : "Esgotado")</span></div><button class="add-to-cart" type="button" aria-label="Adicionar @p.Nome à sacola" disabled="@(!p.Disponivel)">+</button></div></div></article> }</div> }
</section><section class="service-note"><div><span>♡</span><h3>Entrega e retirada</h3><p>@(string.IsNullOrWhiteSpace(Model.FormasEntrega) ? "Combine os detalhes diretamente com a loja." : Model.FormasEntrega)</p></div><div><span>✧</span><h3>Pagamento</h3><p>@(string.IsNullOrWhiteSpace(Model.FormasPagamento) ? "Consulte as formas disponíveis pelo WhatsApp." : Model.FormasPagamento)</p></div><div><span>⌖</span><h3>Região atendida</h3><p>@(string.IsNullOrWhiteSpace(Model.RegiaoAtendida) ? "Fale com a loja para consultar." : Model.RegiaoAtendida)</p></div></section>
