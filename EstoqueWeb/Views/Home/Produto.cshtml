@model EstoqueWeb.ViewModels.ProdutoPublicoViewModel
@{ ViewData["Title"] = Model.Nome; }
<section class="detail-wrap"><a class="back-link" asp-action="Index">← Voltar ao catálogo</a><div class="detail-grid"><div class="detail-image">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Nome" /> } else { <div class="image-placeholder"><span>✿</span><small>foto em breve</small></div> }</div><div class="detail-copy"><p class="eyebrow">@Model.Categoria</p><h1>@Model.Nome</h1><p class="detail-description">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Consulte a loja para mais detalhes sobre este produto." : Model.Descricao)</p><strong class="detail-price">@Model.PrecoVenda.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><p class="availability @(Model.Disponivel ? "" : "sold-out")">@(Model.Disponivel ? "Disponível para consultar" : "Esgotado no momento")</p><a class="button button-dark" asp-controller="Home" asp-action="Index" asp-fragment="catalogo">Ver catálogo</a><p class="muted">Preço e disponibilidade serão confirmados pela loja.</p></div></div></section>
