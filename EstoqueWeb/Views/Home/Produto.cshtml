@model EstoqueWeb.ViewModels.ProdutoPublicoViewModel
@{ ViewData["Title"] = Model.Nome; ViewData["Description"] = string.IsNullOrWhiteSpace(Model.Descricao) ? $"{Model.Nome} — consulte preço e disponibilidade com a loja." : Model.Descricao; }
<section class="detail-wrap"><a class="back-link" asp-action="Index">← Voltar ao catálogo</a><div class="detail-grid"><div class="detail-image">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Nome" /> } else { <div class="image-placeholder"><span>✿</span><small>foto em breve</small></div> }</div><div class="detail-copy"><p class="eyebrow">@Model.Categoria</p><h1>@Model.Nome</h1><p class="detail-description">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Consulte a loja para mais detalhes sobre este produto." : Model.Descricao)</p><strong class="detail-price">@Model.PrecoVenda.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><p class="availability @(Model.Disponivel ? "" : "sold-out")">@(Model.Disponivel ? "Disponível para consultar" : "Esgotado no momento")</p><div class="detail-cart-action" data-product-id="@Model.Id" data-product-name="@Model.Nome" data-price="@Model.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-available="@Model.Disponivel.ToString().ToLowerInvariant()"><button class="button button-dark add-to-cart" type="button" disabled="@(!Model.Disponivel)">Adicionar à sacola</button></div><p class="muted">Preço e disponibilidade serão confirmados pela loja.</p></div></div></section>
